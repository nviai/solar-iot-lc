# ---------------------------------------------------------------------------
# Required — credentials from your application on developer.solaxcloud.com
# (Application -> Authorization Key). Nothing else is needed to run.
# ---------------------------------------------------------------------------
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=

# Regional gateway. The wrong region answers "10400 Bad client credentials".
#   https://openapi-eu.solaxcloud.com   global / EU accounts
#   https://openapi.solaxcloud.com      equivalent
#   https://openapi-cn.solaxcloud.com   CN accounts
OPENAPI_BASE=https://openapi-eu.solaxcloud.com


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Explore the UI with synthetic data; needs no credentials.
DEMO_MODE=false

# Seconds between polls. Each cycle costs 2-3 API calls per device, which counts
# against the hits/min and hits/day quota of your API service package.
POLL_INTERVAL_SECONDS=60

# Show estimated cost and savings on the history page. Leave the price at 0 to
# hide those columns.
ENERGY_PRICE=0
CURRENCY=USD

# Push every alert to an HTTP endpoint (Slack, Discord, or anything accepting JSON).
ALERT_WEBHOOK_URL=

# Restrict polling to specific dongle registration numbers, comma separated.
# Leave empty to poll everything found in the account.
DEVICES=

# Shared secret verified on inbound data-subscription callbacks. Leave empty to
# accept unauthenticated pushes.
CALLBACK_SECRET=

# Browser origins allowed to call the public API directly (comma separated, or *).
# Server-side consumers such as iot-control do not need this.
CORS_ORIGINS=

# IANA time zone the quiet-hours window is read in.
# Containers run on UTC, so an unset value would shift every schedule.
TIMEZONE=Asia/Ho_Chi_Minh

