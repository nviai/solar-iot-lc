# ---------------------------------------------------------------------------
# Solar Monitor — the only source of power figures. IoT Control never calls
# SolaX; it reads GET {SOLAR_API_URL}/api/v1/power, which the monitor serves
# from memory, so polling it costs no SolaX API quota.
# ---------------------------------------------------------------------------
SOLAR_API_URL=http://localhost:8000

# Where a browser reaches the monitor's UI (sidebar link). Set this when
# SOLAR_API_URL is a container hostname the browser cannot resolve.
SOLAR_PUBLIC_URL=

# Seconds between reads of the monitor, and the per-request timeout.
SOLAR_POLL_SECONDS=10
SOLAR_TIMEOUT_SECONDS=5


# ---------------------------------------------------------------------------
# Devices and storage
# ---------------------------------------------------------------------------
# JSON inventory of the switches (see devices.example.json). Holds Tuya local
# keys — keep it out of version control.
DEVICES_FILE=devices.json

# Activity-log retention, in days.
RETENTION_DAYS=90

# IANA time zone the automation windows are read in. Containers run on UTC,
# so an unset value would shift every schedule. Like the off-peak hours
# below, this is only a device's starting value: each device's own setting,
# edited in the UI, takes over once saved.
TIMEZONE=Asia/Ho_Chi_Minh

# Default off-peak (cheap-rate) window for off-peak mode. May cross midnight.
OFFPEAK_START=20:30
OFFPEAK_END=04:30
